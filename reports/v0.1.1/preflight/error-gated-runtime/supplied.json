            "arguments": {
              "question": "What is the average current price of securities in each sector?",
              "sql": "SELECT T2.sector_name, AVG(T1.current_price) AS average_price FROM securities AS T1 INNER JOIN sectors AS T2 ON T1.sector_id = T2.sector_id GROUP BY T2.sector_name ORDER BY average_price DESC;",
