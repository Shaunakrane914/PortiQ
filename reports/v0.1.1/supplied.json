              "sql": "SELECT p.portfolio_name, SUM(h.quantity * s.current_price) AS tech_value, total_portfolio.total_value, ROUND(100.0 * SUM(h.quantity * s.current_price) / total_portfolio.total_value, 2) AS percentage_of_total FROM portfolios p JOIN holdings h ON p.portfolio_id = h.portfolio_id JOIN securities s ON h.security_id = s.security_id JOIN sectors sec ON s.sector_id = sec.sector_id JOIN (SELECT portfolio_id, SUM(quantity * current_price) AS total_value FROM holdings JOIN securities USING (security_id) GROUP BY portfolio_id) AS total_portfolio ON p.portfolio_id = total_portfolio.portfolio_id WHERE sec.sector_name = 'Technology' GROUP BY p.portfolio_id, total_portfolio.total_value ORDER BY percentage_of_total DESC",
