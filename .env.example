GEMINI_API_KEY=
# Verified with this account; availability can change. Run doctor --live.
GEMINI_MODEL=gemini-3.1-flash-lite
PORTIQ_DB=portfolio_database.db
PORTIQ_SOURCE=.
PORTIQ_REQUEST_INTERVAL=13

# Optional local platform controls (defaults shown).
PORTIQ_DAILY_REQUESTS=200
# Set a writable shared file to persist the atomic UTC-day counter.
# PORTIQ_QUOTA_DB=.portiq/quota.sqlite
# At most two explicit account-supported alternatives; no automatic discovery.
PORTIQ_FALLBACK_MODELS=
PORTIQ_CIRCUIT_FAILURES=3
PORTIQ_CIRCUIT_SECONDS=30
# Required before serving outside loopback; keep private.
# PORTIQ_DEMO_TOKEN=
PORTIQ_RATE_LIMIT=60
# Explicit additional values only; no CORS wildcard.
# PORTIQ_CORS_ORIGINS=https://your-demo.example
# PORTIQ_ALLOWED_HOSTS=your-demo.example
