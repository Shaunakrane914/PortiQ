GEMINI_API_KEY=
# Verified with this account; availability can change. Run doctor --live.
GEMINI_MODEL=gemini-3.1-flash-lite
PORTIQ_DB=portfolio_database.db
PORTIQ_SOURCE=.
PORTIQ_REQUEST_INTERVAL=13

# Optional local platform controls (defaults shown).
PORTIQ_DAILY_REQUESTS=200
# Set a writable shared file to persist the atomic UTC-day counter.
# PORTIQ_QUOTA_DB=.portiq/quota.sqlite
# At most two explicit account-supported alternatives; no automatic discovery.
PORTIQ_FALLBACK_MODELS=
PORTIQ_CIRCUIT_FAILURES=3
PORTIQ_CIRCUIT_SECONDS=30
# CLI serve requires this for a host other than 127.0.0.1 / localhost.
# A configured token is always enforced by the API; keep it private.
# PORTIQ_DEMO_TOKEN=
# Module/Docker startup alternatively supports explicit anonymous demo access.
# This does not relax the CLI serve network-bind guard.
# PORTIQ_ALLOW_ANONYMOUS=1
# Module/Docker bind settings; CLI serve uses --host / --port instead.
# PORTIQ_HOST=127.0.0.1
# PORT=8000
# Socket-client HTTP limit; separate from Gemini RPM and SDK pacing.
PORTIQ_RATE_LIMIT=60
# Explicit CORS origins only; the CORS wildcard is rejected.
# PORTIQ_CORS_ORIGINS=https://your-demo.example
# Additional accepted hosts. An explicit '*' is supported for anonymous demos;
# the Render blueprint opts into that behavior. See docs/SUBMISSION.md.
# PORTIQ_ALLOWED_HOSTS=your-demo.example
